# Anthropic (Claude) is the PRIMARY provider for every LLM-backed feature in
# the app (chat/skill responses, code finalization, image/vision analysis,
# transcription responses, /hoy's dumping analysis, etc). Get your key from
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Optional: extra accounts tried in order if the one above fails (e.g. quota).
# ANTHROPIC_FALLBACK_API_KEY=
# ANTHROPIC_SECONDARY_API_KEY=
# ANTHROPIC_QUOTA_COOLDOWN_MS=600000

# Google Gemini is the FALLBACK provider: used automatically when Claude is
# unavailable or over quota/billing (and Claude alone if Gemini isn't
# configured at all). Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_QUOTA_COOLDOWN_MS=600000

# STT Configuration (Silero VAD + faster-whisper — runs fully local, no API key needed)
# Copy this file to .env and fill in your actual values.

# Optional: path to a specific Python executable.
# If omitted, the sidecar uses stt/venv/Scripts/python.exe (Windows) or
# stt/venv/bin/python (Unix/Mac). Run stt/setup.bat first to create the venv.
# PYTHON_PATH=C:\Users\you\AppData\Local\Programs\Python\Python311\python.exe

# Optional speaker diarization for long Secretaria meetings (Alt+S roadmap).
# Requires accepting the pyannote model terms in Hugging Face before first use.
# VYSPER_PYANNOTE_TOKEN=hf_your_huggingface_token_here
# VYSPER_PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
# VYSPER_PYANNOTE_DEVICE=auto

# Voice fingerprints: lets diarize.py resolve SPEAKER_XX to real names when a
# match is found in the enrolled voiceprints store (see stt/enroll_speaker.py).
# Also requires accepting the pyannote/embedding model terms in Hugging Face.
# VYSPER_VOICEPRINT_MODEL=pyannote/embedding
# VYSPER_VOICEPRINT_THRESHOLD=0.75
# VYSPER_VOICEPRINTS_PATH=~/.Vysper/voiceprints.json

# Long Secretaria meeting mode (Alt+S).
# VYSPER_MEETING_SEGMENT_SEC=300
# VYSPER_MEETING_OVERLAP_SEC=3
# VYSPER_MEETING_SEGMENT_SUMMARY=1
# VYSPER_MEETING_FINAL_TRANSCRIPT_CHARS=60000

# Modo Optimizacion (Alt+O), entrevista dirigida en paralelo a Alt+S.
# Arma el modo con Alt+O ANTES de presionar Alt+S: la sesion arranca con
# fragmentos cortos (VYSPER_OPTIMIZACION_SEGMENT_SEC) en vez del segmento
# normal de VYSPER_MEETING_SEGMENT_SEC, para detectar pausas casi en vivo.
# VYSPER_OPTIMIZACION_SEGMENT_SEC=15
# VYSPER_OPTIMIZACION_SILENCE_SEC=6
# VYSPER_OPTIMIZACION_CONTEXT_CHARS=8000

# Optional LightRAG behavioral context (used by the "secretaria"/coaching skills).
# If omitted, defaults to stt/setup's platform default LightRAG checkout
# (F:\Desarrollo\MiRag\LightRAG\.env on Windows, /media/san/.../LightRAG/.env on Linux).
# VYSPER_RAG_URL=http://localhost:9621
# VYSPER_RAG_ENV_FILE=F:\Desarrollo\MiRag\LightRAG\.env
# VYSPER_LIGHTRAG_DIR=F:\Desarrollo\MiRag\LightRAG

# Modo Silia (lider de proyecto interino) — delega en Cerebro (Jira, Notion,
# GitHub, RAG). Ver README.md, seccion "Modo Silia".
# CEREBRO_PATH=/media/san/Miscosas6/Desarrollo/Cerebro
# CEREBRO_PYTHON=/media/san/Miscosas6/Desarrollo/Cerebro/.venv/bin/python
# CEREBRO_TIMEOUT_MS=420000
# VYSPER_SILIA_ASSIGNEE=tu.correo@empresa.com

# Comando /actualizaRag (secretaria, silia, system-design) — corre
# "./build.sh --actualiza" en SandraRagCreAI. Ver README.md, seccion
# "Modo Silia".
# VYSPER_SANDRA_RAG_DIR=/media/san/Miscosas6/Desarrollo/SandraRagCreAI
# VYSPER_SANDRA_RAG_ACTUALIZA_TIMEOUT_MS=900000

# Acceso remoto por Tailscale (audio desde el celular). Se activa con
# "vys.sh --server". Ver README.md, seccion "Acceso remoto por Tailscale".
# VYSPER_HTTP_USER y VYSPER_HTTP_PASSWORD son requeridos para que el
# servidor arranque (Basic Auth); el resto tiene default razonable.
# VYSPER_HTTP_USER=tu_usuario
# VYSPER_HTTP_PASSWORD=una_contrasena_fuerte
# VYSPER_HTTP_PORT=8080
# VYSPER_HTTP_UPLOAD_DIR=/tmp/vysper_audio
# VYSPER_HTTP_LOG=/media/san/Miscosas6/log/vysper_http.log
# VYSPER_HTTP_MAX_MB=200
